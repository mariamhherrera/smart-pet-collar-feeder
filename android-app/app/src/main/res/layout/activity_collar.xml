<?xml version="1.0" encoding="utf-8"?>
<!-- Collar screen: connection, heart rate and activity (COL-2, COL-5). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/background">

    <include layout="@layout/top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="32dp">

            <!-- ===== Collar connection ===== -->
            <LinearLayout
                style="@style/Pt.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        style="@style/Pt.Icon"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:padding="13dp"
                        android:background="@drawable/bg_icon_teal"
                        android:src="@drawable/ic_pets"
                        android:tint="@color/primary"
                        android:contentDescription="Collar" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Smart collar"
                            style="@style/Pt.Title"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/textCollarStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Disconnected"
                            android:textSize="13sp"
                            android:textColor="#DC2626"
                            android:fontFamily="@font/plus_jakarta_sans_semibold"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/buttonSearchCollar"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:minHeight="44dp"
                    android:text="Search for collar"
                    android:textSize="14sp"
                    android:textColor="@color/primary"
                    android:background="@drawable/bg_secondary_button"
                    android:stateListAnimator="@null"
                    android:layout_marginTop="16dp" />
            </LinearLayout>

            <!-- ===== Heart rate (COL-5.3 fills in the number) ===== -->
            <LinearLayout
                style="@style/Pt.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        style="@style/Pt.Icon"
                        android:background="@drawable/bg_icon_red"
                        android:src="@drawable/ic_monitor_heart"
                        android:tint="@color/heart"
                        android:contentDescription="Heart rate" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Heart rate"
                        style="@style/Pt.Label"
                        android:layout_marginStart="10dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/textCollarHeartRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        style="@style/Pt.Metric"
                        android:textSize="40sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BPM"
                        style="@style/Pt.Label"
                        android:textSize="13sp"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Most accurate while your pet is resting"
                    style="@style/Pt.Body"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- ===== Activity right now (COL-2.2 fills in the label) ===== -->
            <LinearLayout
                style="@style/Pt.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        style="@style/Pt.Icon"
                        android:background="@drawable/bg_icon_teal"
                        android:src="@drawable/ic_directions_run"
                        android:tint="@color/primary"
                        android:contentDescription="Activity" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Activity now"
                        style="@style/Pt.Label"
                        android:layout_marginStart="10dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textCollarActivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No data yet"
                    style="@style/Pt.Metric"
                    android:textSize="26sp"
                    android:layout_marginTop="12dp" />

                <!-- Raw numbers from the motion sensor, handy for testing -->
                <TextView
                    android:id="@+id/textCollarMotion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Waiting for the collar"
                    style="@style/Pt.Body"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- ===== Today: minutes per activity (COL-2.3) ===== -->
            <LinearLayout
                style="@style/Pt.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today"
                    style="@style/Pt.Label" />

                <!-- Resting -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="14dp">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/dot_resting" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Resting"
                        style="@style/Pt.Title"
                        android:layout_marginStart="10dp" />

                    <TextView
                        android:id="@+id/textMinutesResting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- min"
                        style="@style/Pt.Body"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Walking -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/dot_walking" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Walking"
                        style="@style/Pt.Title"
                        android:layout_marginStart="10dp" />

                    <TextView
                        android:id="@+id/textMinutesWalking"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- min"
                        style="@style/Pt.Body"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Running -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/dot_running" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Running"
                        style="@style/Pt.Title"
                        android:layout_marginStart="10dp" />

                    <TextView
                        android:id="@+id/textMinutesRunning"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- min"
                        style="@style/Pt.Body"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/bottom_nav" />
</LinearLayout>
