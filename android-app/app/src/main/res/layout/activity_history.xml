<?xml version="1.0" encoding="utf-8"?>
<!-- UI-6 History graphs page: meals and activity for the past week / month / year,
     and movement and sleep for any day.
     Top bar and bottom bar are shared with the other main pages. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/background">

    <include layout="@layout/top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="32dp">

            <!-- UI-6.2: graphs from the history saved in Firebase with a time (UI-6.1) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your pet's history, from the readings and meals saved in Firebase."
                style="@style/Pt.Body"
                android:textSize="14sp" />

            <!-- UI-6.2: Week / Month / Year selector (same chips as the safe zone size in Settings) -->
            <RadioGroup
                android:id="@+id/rangeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginStart="-4dp"
                android:layout_marginEnd="-4dp">

                <RadioButton
                    android:id="@+id/rangeWeek"
                    style="@style/Pt.Chip"
                    android:checked="true"
                    android:text="Week" />

                <RadioButton
                    android:id="@+id/rangeMonth"
                    style="@style/Pt.Chip"
                    android:text="Month" />

                <RadioButton
                    android:id="@+id/rangeYear"
                    style="@style/Pt.Chip"
                    android:text="Year" />
            </RadioGroup>

            <!-- Meals for the chosen range -->
            <LinearLayout
                style="@style/Pt.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            style="@style/Pt.Icon"
                            android:background="@drawable/bg_icon_orange"
                            android:src="@drawable/ic_restaurant"
                            android:tint="@color/accent"
                            android:contentDescription="Meals" />

                        <TextView
                            android:id="@+id/textMealsTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Meals, past week"
                            style="@style/Pt.Label"
                            android:layout_marginStart="10dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textMealsSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="--"
                        style="@style/Pt.Metric"
                        android:textSize="22sp"
                        android:layout_marginTop="12dp" />

                    <com.example.pettracker.charts.SimpleChartView
                        android:id="@+id/chartMeals"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- Activity for the chosen range: percent of the time the pet was moving -->
            <LinearLayout
                style="@style/Pt.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            style="@style/Pt.Icon"
                            android:background="@drawable/bg_icon_teal"
                            android:src="@drawable/ic_directions_run"
                            android:tint="@color/primary"
                            android:contentDescription="Activity" />

                        <TextView
                            android:id="@+id/textActivityTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Activity, past week"
                            style="@style/Pt.Label"
                            android:layout_marginStart="10dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textActivitySummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="--"
                        style="@style/Pt.Metric"
                        android:textSize="22sp"
                        android:layout_marginTop="12dp" />

                    <com.example.pettracker.charts.SimpleChartView
                        android:id="@+id/chartActivity"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="12dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pick a day"
                style="@style/Pt.Label"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <!-- UI-6.1: load old readings by date -->
            <LinearLayout
                style="@style/Pt.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/buttonPrevDay"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:background="@drawable/bg_tile"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@color/primary"
                    android:contentDescription="Previous day" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:id="@+id/textDay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today"
                        style="@style/Pt.Title"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/textDayMeals"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        style="@style/Pt.Body"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/buttonNextDay"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:background="@drawable/bg_tile"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@color/primary"
                    android:rotation="180"
                    android:contentDescription="Next day" />

            </LinearLayout>

            <LinearLayout
                style="@style/Pt.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            style="@style/Pt.Icon"
                            android:background="@drawable/bg_icon_teal"
                            android:src="@drawable/ic_directions_run"
                            android:tint="@color/primary"
                            android:contentDescription="Movement" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Movement"
                            style="@style/Pt.Label"
                            android:layout_marginStart="10dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textMovementSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="--"
                        style="@style/Pt.Metric"
                        android:textSize="22sp"
                        android:layout_marginTop="12dp" />

                    <com.example.pettracker.charts.SimpleChartView
                        android:id="@+id/chartMovement"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="12dp" />
            </LinearLayout>

            <LinearLayout
                style="@style/Pt.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            style="@style/Pt.Icon"
                            android:background="@drawable/bg_icon_teal"
                            android:src="@drawable/ic_bedtime"
                            android:tint="@color/primary"
                            android:contentDescription="Sleep" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sleep that night"
                            style="@style/Pt.Label"
                            android:layout_marginStart="10dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textSleepSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="--"
                        style="@style/Pt.Metric"
                        android:textSize="22sp"
                        android:layout_marginTop="12dp" />

                    <com.example.pettracker.charts.SimpleChartView
                        android:id="@+id/chartSleep"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="12dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/bottom_nav" />
</LinearLayout>
