<?xml version="1.0" encoding="utf-8"?>
<!-- COM-4.2 Pair your collar.
     Two parts on the same page (PairCollarActivity shows one at a time):
       1. layoutSearch: looking for the collar, or type its ID
       2. layoutFound:  "Collar found", battery, signal, link it to the pet -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/background">

    <include layout="@layout/top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <!-- Only shown right after registering (step 1 = pet profile) -->
            <TextView
                android:id="@+id/textStep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 2 of 2"
                style="@style/Pt.Label"
                android:textColor="@color/primary_dark"
                android:background="@drawable/bg_step"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginBottom="16dp" />

            <!-- ===== 1. Looking for the collar ===== -->
            <LinearLayout
                android:id="@+id/layoutSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/Pt.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            style="@style/Pt.Icon"
                            android:background="@drawable/bg_icon_teal"
                            android:src="@drawable/ic_pets"
                            android:tint="@color/primary"
                            android:contentDescription="Collar" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Turn on the collar"
                                style="@style/Pt.Title" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Keep it on Wi-Fi. The app finds it by itself."
                                style="@style/Pt.Body"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_tile"
                        android:padding="12dp"
                        android:layout_marginTop="14dp">

                        <ProgressBar
                            android:id="@+id/progressSearching"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:indeterminate="true"
                            android:indeterminateTint="@color/primary" />

                        <TextView
                            android:id="@+id/textSearching"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Looking for your collar…"
                            style="@style/Pt.Body"
                            android:layout_marginStart="10dp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    style="@style/Pt.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Or enter the collar ID"
                        style="@style/Pt.Label"
                        android:layout_marginBottom="10dp" />

                    <EditText
                        android:id="@+id/editCollarId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:hint="e.g. PC-3C71F2"
                        android:inputType="textCapCharacters|textNoSuggestions"
                        android:singleLine="true"
                        android:background="@drawable/bg_input"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="It is on the sticker under the pod."
                        style="@style/Pt.Body"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 2. Collar found ===== -->
            <LinearLayout
                android:id="@+id/layoutFound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    style="@style/Pt.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Collar found"
                        style="@style/Pt.Label" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <ImageView
                            style="@style/Pt.Icon"
                            android:background="@drawable/bg_icon_teal"
                            android:src="@drawable/ic_check"
                            android:tint="@color/primary"
                            android:contentDescription="Found" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/textFoundId"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PC-000000"
                                style="@style/Pt.Metric"
                                android:textSize="24sp" />

                            <TextView
                                android:id="@+id/textFoundStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                style="@style/Pt.Body"
                                android:textColor="@color/primary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Battery and Wi-Fi signal, side by side -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/bg_tile"
                            android:padding="12dp"
                            android:layout_marginEnd="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Battery"
                                style="@style/Pt.Label" />

                            <TextView
                                android:id="@+id/textFoundBattery"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                style="@style/Pt.Metric"
                                android:textSize="18sp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/bg_tile"
                            android:padding="12dp"
                            android:layout_marginStart="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Signal"
                                style="@style/Pt.Label" />

                            <TextView
                                android:id="@+id/textFoundSignal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                style="@style/Pt.Metric"
                                android:textSize="18sp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    style="@style/Pt.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:id="@+id/textFoundQuestion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Link this collar to your pet?"
                        style="@style/Pt.Title" />

                    <TextView
                        android:id="@+id/textFoundNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Readings from other collars will not show for your pet."
                        style="@style/Pt.Body"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Errors (COM-4.3): wrong ID, collar not found, linked to another account -->
            <TextView
                android:id="@+id/textPairError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/heart"
                android:textSize="13sp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:background="@drawable/bg_alert"
                android:padding="12dp"
                android:layout_marginTop="16dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- Buttons stay at the bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <Button
            android:id="@+id/buttonPairMain"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Link collar"
            android:textSize="16sp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/buttonPairSecond"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Skip for now"
            android:textSize="16sp"
            android:textColor="@color/primary"
            android:background="@drawable/bg_secondary_button"
            android:stateListAnimator="@null"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</LinearLayout>
