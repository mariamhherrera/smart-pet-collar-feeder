{
  "rules": {
    ".read": false,
    ".write": false,
    "owners": {
      "$ownerUid": {
        ".read": "auth != null && auth.uid === $ownerUid",
        ".write": "auth != null && auth.uid === $ownerUid",
        "feeder": {
          "feedings": {
            ".indexOn": ["time"]
          }
        }
      }
    }
  }
}
