<?xml version="1.0" encoding="utf-8"?>
<!-- UI-6 History graphs page: meals per day, movement and heart rate over time.
     Top bar and bottom bar are shared with the other main pages. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/background">

    <include layout="@layout/top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="32dp">

            <!-- UI-6.2: graphs from the history saved in Firebase (UI-6.1) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your pet's history, from the readings and meals saved in Firebase."
                style="@style/Pt.Body"
                android:textSize="14sp" />

            <LinearLayout
                style="@style/Pt.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            style="@style/Pt.Icon"
                            android:background="@drawable/bg_icon_orange"
                            android:src="@drawable/ic_restaurant"
                            android:tint="@color/accent"
                            android:contentDescription="Meals, last 7 days" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Meals, last 7 days"
                            style="@style/Pt.Label"
                            android:layout_marginStart="10dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textMealsSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="--"
                        style="@style/Pt.Metric"
                        android:textSize="22sp"
                        android:layout_marginTop="12dp" />

                    <com.example.pettracker.charts.SimpleChartView
                        android:id="@+id/chartMeals"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="12dp" />
            </LinearLayout>

            <LinearLayout
                style="@style/Pt.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            style="@style/Pt.Icon"
                            android:background="@drawable/bg_icon_teal"
                            android:src="@drawable/ic_directions_run"
                            android:tint="@color/primary"
                            android:contentDescription="Movement, last hour" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Movement, last hour"
                            style="@style/Pt.Label"
                            android:layout_marginStart="10dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textMovementSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="--"
                        style="@style/Pt.Metric"
                        android:textSize="22sp"
                        android:layout_marginTop="12dp" />

                    <com.example.pettracker.charts.SimpleChartView
                        android:id="@+id/chartMovement"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="12dp" />
            </LinearLayout>

            <LinearLayout
                style="@style/Pt.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            style="@style/Pt.Icon"
                            android:background="@drawable/bg_icon_red"
                            android:src="@drawable/ic_monitor_heart"
                            android:tint="@color/heart"
                            android:contentDescription="Heart rate, last hour" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Heart rate, last hour"
                            style="@style/Pt.Label"
                            android:layout_marginStart="10dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textHeartSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="--"
                        style="@style/Pt.Metric"
                        android:textSize="22sp"
                        android:layout_marginTop="12dp" />

                    <com.example.pettracker.charts.SimpleChartView
                        android:id="@+id/chartHeart"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="12dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/bottom_nav" />
</LinearLayout>
