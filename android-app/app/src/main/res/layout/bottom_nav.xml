<?xml version="1.0" encoding="utf-8"?>
<!-- UI-3.3 Page navigation: bottom bar with the 5 main pages, like the Stitch design.
     Each page adds it with an include tag pointing to this file
     and calls BottomNav.setUp(...) so its own tab is shown in teal. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:orientation="horizontal"
    android:background="@drawable/bg_bottom_nav"
    android:paddingTop="1dp">

    <LinearLayout android:id="@+id/navHome" style="@style/Pt.NavItem">
        <ImageView android:id="@+id/navHomeIcon" style="@style/Pt.NavIcon"
            android:src="@drawable/ic_home" android:contentDescription="Home" />
        <TextView android:id="@+id/navHomeText" style="@style/Pt.NavText"
            android:text="Home" />
    </LinearLayout>

    <LinearLayout android:id="@+id/navFeeder" style="@style/Pt.NavItem">
        <ImageView android:id="@+id/navFeederIcon" style="@style/Pt.NavIcon"
            android:src="@drawable/ic_restaurant" android:contentDescription="Feeder" />
        <TextView android:id="@+id/navFeederText" style="@style/Pt.NavText"
            android:text="Feeder" />
    </LinearLayout>

    <LinearLayout android:id="@+id/navCollar" style="@style/Pt.NavItem">
        <ImageView android:id="@+id/navCollarIcon" style="@style/Pt.NavIcon"
            android:src="@drawable/ic_pets" android:contentDescription="Collar" />
        <TextView android:id="@+id/navCollarText" style="@style/Pt.NavText"
            android:text="Collar" />
    </LinearLayout>

    <LinearLayout android:id="@+id/navHistory" style="@style/Pt.NavItem">
        <ImageView android:id="@+id/navHistoryIcon" style="@style/Pt.NavIcon"
            android:src="@drawable/ic_bar_chart" android:contentDescription="History" />
        <TextView android:id="@+id/navHistoryText" style="@style/Pt.NavText"
            android:text="History" />
    </LinearLayout>

    <LinearLayout android:id="@+id/navSettings" style="@style/Pt.NavItem">
        <ImageView android:id="@+id/navSettingsIcon" style="@style/Pt.NavIcon"
            android:src="@drawable/ic_settings" android:contentDescription="Settings" />
        <TextView android:id="@+id/navSettingsText" style="@style/Pt.NavText"
            android:text="Settings" />
    </LinearLayout>
</LinearLayout>
